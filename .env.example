# Leonety environment template
#
# NEXT_PUBLIC_* values are included in the browser bundle and must never contain
# secrets. Every other credential below is server-only unless noted otherwise.

# Application
# Browser-safe canonical application origin. Do not add a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NODE_ENV is supplied by Next.js/Vercel and is intentionally not set here.

# Server-only Leonety operator/contact addresses.
ADMIN_EMAIL=
LEONETY_CONTACT_EMAIL=
UPGRADE_REQUEST_ADMIN_EMAIL=

# Supabase
# Browser-safe project URL and anon key. RLS must protect exposed tables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose through NEXT_PUBLIC_* or a browser response.
SUPABASE_SERVICE_ROLE_KEY=

# Authentication and OAuth imports
# Google/Facebook sign-in is configured in Supabase. These separate credentials
# are for the Google Contacts import flow.
GOOGLE_CONTACTS_CLIENT_ID=
GOOGLE_CONTACTS_CLIENT_SECRET=

# Billing
# Current checkout implementation uses Paddle.
BILLING_PROVIDER=paddle
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_STARTER_PRICE_ID=
PADDLE_PRO_PRICE_ID=
PADDLE_BUSINESS_PRICE_ID=

# Referenced by the billing abstraction, but Stripe checkout is not implemented.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=

# Transactional email (Resend)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_PRODUCT_NAME=Leonety

# AI (server-only OpenAI adapter)
AI_PROVIDER=openai
AI_MODEL=gpt-5-mini
AI_API_KEY=

# Supported fallback alias. Configure one API key, not both.
OPENAI_API_KEY=

# Web Push / VAPID
# The public key is non-secret but is delivered to the browser by a server route.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=

# Address autocomplete
# Supported values: nominatim (default) or google_maps.
ADDRESS_PROVIDER=nominatim
GOOGLE_MAPS_API_KEY=

# Integration credential protection
# Server-only secret with at least 32 characters. Keep it stable across deploys.
LEONETY_CREDENTIAL_ENCRYPTION_KEY=

# Store integrations
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2025-10

# Google Merchant OAuth; separate from Google Login and Google Contacts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WooCommerce credentials are per-workspace and stored encrypted. There are no
# global WooCommerce credential environment variables in the current code.

# Meta / WhatsApp Business
META_APP_ID=
META_APP_SECRET=
META_WHATSAPP_CONFIG_ID=
GRAPH_API_VERSION=v25.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Legacy fallback alias. Prefer WHATSAPP_WEBHOOK_VERIFY_TOKEN.
WHATSAPP_VERIFY_TOKEN=

# Lieferando / Takeaway has no active credential variables and remains partner-gated.
